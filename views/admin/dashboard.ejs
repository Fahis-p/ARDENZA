<%- include("../../views/partials/admin/header") %>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<section class="content-main">
    <div class="content-header">
        <div>
            <h2 class="content-title card-title">Dashboard</h2>
        </div>
    </div>

    <!-- Sales Report Form -->
    <form id="salesReportForm" class="card p-4 shadow mb-4">
        <div class="mb-3">
            <label for="period" class="form-label">Select Period:</label>
            <select id="period" name="period" class="form-select">
                <option value="daily">Daily</option>
                <option value="weekly">Weekly</option>
                <option value="yearly">Yearly</option>
                <option value="custom">Custom Date Range</option>
            </select>
        </div>

        <!-- Daily Selection (Hidden by Default) -->
        <div id="dailySelection" class="mb-3" style="display: block;">
            <label for="day" class="form-label">Select Day:</label>
            <input type="date" id="day" name="day" class="form-control">
        </div>

        <!-- Weekly Selection (Hidden by Default) -->
        <div id="weeklySelection" class="mb-3" style="display: none;">
            <label for="week" class="form-label">Select Week:</label>
            <input type="week" id="week" name="week" class="form-control">
        </div>

        <!-- Yearly Selection (Hidden by Default) -->
        <div id="yearlySelection" class="mb-3" style="display: none;">
            <label for="year" class="form-label">Select Year:</label>
            <input type="number" id="year" name="year" class="form-control" min="2024" max="2026" value="2025" >
        </div>

        <!-- Custom Date Range (Hidden by Default) -->
        <div id="customDateRange" class="mb-3" style="display: none;">
            <div class="row">
                <div class="col-md-6">
                    <label for="startDate" class="form-label">Start Date:</label>
                    <input type="date" id="startDate" name="startDate" class="form-control">
                </div>
                <div class="col-md-6">
                    <label for="endDate" class="form-label">End Date:</label>
                    <input type="date" id="endDate" name="endDate" class="form-control">
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary w-100">Generate Report</button>
    </form>

    <!-- Report Result Section -->
    <div id="reportResult" class="card p-4 shadow mb-4">
        <h4 class="text-center mb-4">Report Summary</h4>
        <div class="row">
            <div class="col-md-4">
                <div class="card text-center p-3">
                    <h5>Total Sales</h5>
                    <p id="totalSales" class="fs-4"><%=totalSales%></p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center p-3">
                    <h5>Total Discounts</h5>
                    <p id="totalDiscounts" class="fs-4"><%=totalDiscounts%></p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center p-3">
                    <h5>Total Orders</h5>
                    <p id="totalOrders" class="fs-4"><%=totalOrders%></p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-4">
        <div class="col-12">
          <div class="chart-container">
            <div class="chart-header">
              <h5 class="chart-title mb-0">Best Selling Products</h5>
            </div>
            <div class="table-responsive">
              <table class="table align-middle">
                <thead>
                  <tr>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Sold</th>
                    <th>Revenue</th>
                  </tr>
                </thead>
                <tbody id="bestSellingProductsBody">
                    <!-- Rows will be dynamically inserted here -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
  

    <!-- Download Buttons -->
    <div class="text-center">
        <button id="downloadPdf" class="btn btn-danger me-2">Download PDF</button>
        <button id="downloadExcel" class="btn btn-success">Download Excel</button>
    </div>
</section>

<script>
    document.getElementById('period').addEventListener('change', function () {
    const period = this.value;
    const dailySelection = document.getElementById('dailySelection');
    const weeklySelection = document.getElementById('weeklySelection');
    const yearlySelection = document.getElementById('yearlySelection');
    const customDateRange = document.getElementById('customDateRange');

    // Hide all fields initially
    dailySelection.style.display = 'none';
    weeklySelection.style.display = 'none';
    yearlySelection.style.display = 'none';
    customDateRange.style.display = 'none';

    // Show the relevant field based on the selected period
    if (period === 'daily') {
        dailySelection.style.display = 'block';
    } else if (period === 'weekly') {
        weeklySelection.style.display = 'block';
    } else if (period === 'yearly') {
        yearlySelection.style.display = 'block';

    } else if (period === 'custom') {
        customDateRange.style.display = 'block';
    }
});

document.getElementById('salesReportForm').addEventListener('submit', async function (e) {
    e.preventDefault();
    const formData = new FormData(this);
     
    // Log FormData entries for debugging
    for (const [key, value] of formData.entries()) {
        console.log(key, value);
    }

    const period = formData.get('period');

    // Add additional data based on the selected period
    if (period === 'daily') {
        const day = formData.get('day');
        formData.append('date', day);
    } else if (period === 'weekly') {
        const week = formData.get('week');
        const [startDate, endDate] = getStartAndEndDateOfWeek(week);
        formData.append('startDate', startDate);
        formData.append('endDate', endDate);
    } else if (period === 'yearly') {
        const year = formData.get('year');
        formData.append('year', year); 
    }

    const params = new URLSearchParams(formData);

    
    const response = await fetch(`admin/salesReport?${params}`);
    const data = await response.json();

    if (response.status === 400) {
        alert(`❌ Error: ${data.error}`);
        return;
    }

    // Display report data
    document.getElementById('totalSales').textContent = `₹${data.reportData.totalSales}`;
    document.getElementById('totalDiscounts').textContent = `₹${data.reportData.totalDiscounts}`;
    document.getElementById('totalOrders').textContent = data.reportData.totalOrders;

    updateBestSellingProductsTable(data.topProducts)

});

function updateBestSellingProductsTable(topProducts) {
    const tableBody = document.getElementById('bestSellingProductsBody');

    // Clear existing rows
    tableBody.innerHTML = '';

    // Check if there are products to display
    if (Array.isArray(topProducts) && topProducts.length > 0) {
        // Add new rows for each product
        topProducts.forEach(product => {
            const row = document.createElement('tr');

            row.innerHTML = `
                <td>${product.productName}</td>
                <td>${product.categoryName || 'N/A'}</td>
                <td>₹${(product.price || 0).toFixed(2)}</td>
                <td>${product.totalQuantity}</td>
                <td>₹${product.revenue.toFixed(2)}</td>
            `;

            tableBody.appendChild(row);
        });
    } else {
        // Display a message if no products are found
        const row = document.createElement('tr');
        row.innerHTML = `
            <td colspan="5" class="text-center">No products found for the selected period.</td>
        `;
        tableBody.appendChild(row);
    }
}

document.getElementById('downloadPdf').addEventListener('click', function () {

    const formData = new FormData(document.getElementById('salesReportForm'));
     
    const period = formData.get('period');

    // Add additional data based on the selected period
    if (period === 'daily') {
        const day = formData.get('day');
        formData.append('date', day);
    } else if (period === 'weekly') {
        const week = formData.get('week');
        const [startDate, endDate] = getStartAndEndDateOfWeek(week);
        formData.append('startDate', startDate);
        formData.append('endDate', endDate);
    } else if (period === 'yearly') {
        const year = formData.get('year');
        formData.append('year', year); 
    }

    const params = new URLSearchParams(formData);
    window.open(`admin/salesReport/pdf?${params}`, '_blank');
});

document.getElementById('downloadExcel').addEventListener('click', function () {
    
    const formData = new FormData(document.getElementById('salesReportForm'));
     
    const period = formData.get('period');

    // Add additional data based on the selected period
    if (period === 'daily') {
        const day = formData.get('day');
        formData.append('date', day);
    } else if (period === 'weekly') {
        const week = formData.get('week');
        const [startDate, endDate] = getStartAndEndDateOfWeek(week);
        formData.append('startDate', startDate);
        formData.append('endDate', endDate);
    } else if (period === 'yearly') {
        const year = formData.get('year');
        formData.append('year', year); 
    }

    const params = new URLSearchParams(formData);



    window.open(`admin/salesReport/excel?${params}`, '_blank');
});

// Helper function to get the start and end date of a week
function getStartAndEndDateOfWeek(week) {
    const [year, weekNumber] = week.split('-W');
    const startDate = new Date(year, 0, 1 + (weekNumber - 1) * 7);
    const endDate = new Date(startDate);
    endDate.setDate(startDate.getDate() + 6);
    return [startDate.toISOString().split('T')[0], endDate.toISOString().split('T')[0]];
}
</script>

<%- include("../../views/partials/admin/footer") %>
